# ── File ini adalah TEMPLATE. Salin menjadi .env lalu isi nilainya. ────────────
# JANGAN commit file .env ke git!

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=sorotpaham
POSTGRES_PASSWORD=               # WAJIB: password kuat untuk DB
POSTGRES_DB=sorotpaham

# ─── Backend ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=                      # WAJIB: string acak minimal 32 karakter

# URL frontend yang diizinkan CORS (tanpa trailing slash)
CLIENT_ORIGIN=https://yourdomain.com

# ─── 9router ────────────────────────────────────────────────────────────────────
# URL base 9router di VPS TencentCloud. Contoh: http://43.xxx.xxx.xxx:20128/v1
NINEROUTER_BASE_URL=             # WAJIB

# API key dari dashboard 9router
NINEROUTER_API_KEY=

# Model yang dikirim ke 9router:
#   "auto"            → 9router memilih berdasarkan routing rules
#   "gemini-2.5-flash"
#   "muse-spark-1.1"
#   "glm-5"
LLM_MODEL=auto
