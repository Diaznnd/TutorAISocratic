# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Untuk Docker Compose, HOST adalah nama service (misal: db)
DATABASE_URL="postgresql://sorotpaham:changeme@db:5432/sorotpaham"

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Wajib diisi, minimal 32 karakter acak. Contoh: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Origin frontend yang diizinkan (tanpa trailing slash)
CLIENT_ORIGIN=https://yourdomain.com

# ─── 9router (LLM Gateway) ──────────────────────────────────────────────────────
# URL base endpoint 9router yang sudah di-deploy di VPS TencentCloud
# Contoh: http://43.xxx.xxx.xxx:20128/v1
NINEROUTER_BASE_URL=http://<IP_PUBLIC>:<PORT>/v1

# API key dari dashboard 9router
NINEROUTER_API_KEY=your-9router-api-key

# Model yang dikirim ke 9router. Bisa "auto" (9router yang pilih), atau
# nama model spesifik seperti: gemini-2.5-flash / muse-spark-1.1 / glm-5
LLM_MODEL=auto
